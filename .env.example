# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side Supabase key (has admin rights — NEVER expose to the browser).
# Used only by scripts (seed, create-admin). Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Business details
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Optional: Google Sheets sync. Create an Apps Script webhook that appends a
# row for each new lead, then paste its URL here. Leave empty to disable.
GOOGLE_SHEETS_WEBHOOK_URL=
